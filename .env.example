APP_NAME=SkyGuardian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Kyiv

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skyguardian
DB_USERNAME=skyguardian
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SKYGUARDIAN_TELETHON_HOST=127.0.0.1
SKYGUARDIAN_TELETHON_PORT=8787
SKYGUARDIAN_TELETHON_TIMEOUT=60
SKYGUARDIAN_QR_TTL=120
PLAYWRIGHT_BROWSERS_PATH=
SKYGUARDIAN_BET_BROWSER_CONCURRENCY=3
SKYGUARDIAN_BET_NAVIGATION_TIMEOUT_MS=12000
SKYGUARDIAN_BET_BROWSER_TIMEOUT=90
SKYGUARDIAN_BET_MAX_WEBSITES=20
SKYGUARDIAN_SCHEDULER_MAX_AGE_SECONDS=180
SKYGUARDIAN_HEALTH_SOCKET_TIMEOUT_SECONDS=0.5
SKYGUARDIAN_DISK_MAX_USED_PERCENT=90
SKYGUARDIAN_BACKUP_STATUS_PATH=/var/lib/skyguardian-backup/latest.json
SKYGUARDIAN_BACKUP_MAX_AGE_SECONDS=129600
SKYGUARDIAN_MESSAGE_RETENTION_DAYS=30
SKYGUARDIAN_FAILED_WEBHOOK_RETENTION_DAYS=30
SKYGUARDIAN_AUDIT_RETENTION_DAYS=180
SKYGUARDIAN_SITE_UPLOAD_MAX_MB=20
SKYGUARDIAN_TELEGRAM_UPLOAD_MAX_MB=50

VITE_APP_NAME="${APP_NAME}"
