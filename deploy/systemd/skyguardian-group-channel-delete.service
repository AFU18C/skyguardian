[Unit]
Description=SkyGuardian group-channel technical account delete worker
After=network-online.target mysql.service skyguardian-group-channel-telethon.service
Requires=skyguardian-group-channel-telethon.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/skyguardian
ExecStart=/usr/bin/php artisan skyguardian:group-channel-technical-delete:work
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/skyguardian/storage /var/www/skyguardian/bootstrap/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
