[Unit]
Description=SkyGuardian Telethon daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/skyguardian
EnvironmentFile=-/var/www/skyguardian/.env
ExecStart=/var/www/skyguardian/.venv/bin/python /var/www/skyguardian/telethon/worker.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
